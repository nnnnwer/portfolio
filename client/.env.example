# ---------------------------------------------------------------------------
# Client environment. Copy to .env.local for local overrides.
# Everything prefixed VITE_ is bundled into public JavaScript.
# NEVER put Supabase keys or any secret here.
# ---------------------------------------------------------------------------

# Base URL of the Express API, including /api.
# Local development: leave unset (Vite proxies /api to http://localhost:5000).
# Production (Vercel): https://your-api-name.onrender.com/api
VITE_API_URL=

# Public URL of this website, used for canonical and Open Graph URLs.
# Example: https://owen-thilakoun.vercel.app
VITE_SITE_URL=
